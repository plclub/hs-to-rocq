-Q . ParkourTheories
-Q ../build/run/base ""
-Q ../build/run/transformers ""
-Q ../build/run/manual ""
-Q ../lib ""
-docroot ParkourTheories
-arg -q
-arg -w
-arg +all
# Use the compiler's native-code default. Rocq 9.0's makefile otherwise adds
# a deprecated flag and suppresses its warning after our -w +all.
COQFLAGS = "$(OTHERFLAGS) $(COQFILTEREDEXTRAFLAGS)"
ROCQ = "python3 ../scripts/parkour_rocq.py --driver"

