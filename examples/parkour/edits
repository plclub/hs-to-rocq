# The legacy Empty case has no payload. The Choreo2 API uses a separate,
# evidence-based unwrap; Network needs only LocTm from the legacy module.
skip Choreography.Location.unwrap
data kinds Choreography.Location.@ Type, Parkour.Symbol.Symbol

# The final argument is an index. Existentials in App, Bind, Send, Comm
# and Locally are quantified in their constructor, not fixed parameters.
data type arguments Control.Monad.Tree.Tree (parameters: f) (indices: a)
data type arguments Choreography.Network.NetworkSig (parameters: m) (indices: a)
data kinds Choreography.Network.NetworkSig (Type -> Type), Type
data type arguments Choreography.Choreo2.ChoreoSig (parameters: m p) (indices: a)
data kinds Choreography.Choreo2.ChoreoSig (Type -> Type), Parkour.Symbol.Symbol, Type
