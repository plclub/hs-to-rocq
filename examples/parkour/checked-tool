#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")"
case "${1:-}" in
    check|translate) mode=$1; shift ;;
    *) echo "usage: ./checked-tool {check|translate} hs-to-rocq-arguments..." >&2; exit 2 ;;
esac

# Parse precisely the argv that the locally built translator will receive.
stack --allow-different-user exec --package crypton -- runghc -package=hs-to-rocq -package=crypton CheckEdits.hs "$@"
if [[ "$mode" = translate ]]; then
    exec stack --allow-different-user exec -- "$(stack --allow-different-user path --local-install-root)/bin/hs-to-rocq" "$@"
fi
