#!/usr/bin/env bash
# Recheck the original protocol with only its dependencies visible. Stack
# obtains those packages for the repository's snapshot, bypassing HasChor's
# GHC-9.6-specific Cabal bounds without rebuilding or editing its sources.
set -euo pipefail
cd "$(dirname "$0")"
python3 verify-source.py
work=$(mktemp -d "${TMPDIR:-/tmp}/parkour-ghc.XXXXXXXX")
trap 'rm -rf "$work"' EXIT
packages=() flags=(-hide-all-packages)
while read -r package; do
    packages+=("$package")
    flags+=("-package=$package")
done < upstream-packages.txt
stack=(stack --allow-different-user exec --package "${packages[*]}" --)
[[ "$("${stack[@]}" ghc --numeric-version)" == 9.10.3 ]]
"${stack[@]}" ghc --make -XGHC2021 "${flags[@]}" -fno-code -fforce-recomp \
    -outputdir "$work" -ddump-splices -i -iupstream/src \
    upstream/examples/explicit-parallel/quorum-voting-choreo2/Main.hs > "$work/splices"
cat "$work/splices"
for loc in candidate voter1 voter2 voter3; do
    rg -Fq "$loc :: GHC.TypeLits.SSymbol \"$loc\"" "$work/splices"
done
