#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
case "${1:-}" in
    check|translate|translate-only) mode=$1; shift ;;
    *) echo "usage: $0 {check|translate|translate-only} hs-to-rocq-arguments..." >&2; exit 2 ;;
esac

# Acceptance checks the exact argv used for translation; ordinary builds only translate.
if [[ "$mode" != translate-only ]]; then
    stack --allow-different-user exec --package crypton -- runghc -package=hs-to-rocq -package=crypton scripts/CheckEdits.hs "$@"
fi
if [[ "$mode" != check ]]; then
    exec stack --allow-different-user exec -- "$(stack --allow-different-user path --local-install-root)/bin/hs-to-rocq" "$@"
fi
