# AST string expectations anchor literals in raw preambles, midambles and proofs.
add RocqQuotedText Theorem RocqQuotedText.preambleLiteral_preserved :
  preambleLiteral = "Coq.Init.Decimal".
Proof.
  pose ("Coq.Init.Decimal") as path.
  pose proof Coq.Program.Wf.WfExtensionality.fix_sub_eq_ext.
  exact (eq_refl "Coq.Init.Decimal").
Qed.

